<?xml version="1.0" encoding="utf-8"?>
<SettingConfiguration xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>fixed_fill1350_inv70</Name>
  <SimulationWarmupTime>0</SimulationWarmupTime>
  <SimulationDuration>14400</SimulationDuration>
  <Seed>0</Seed>
  <LogLevel>Info</LogLevel>
  <LogFileLevel>All</LogFileLevel>
  <MonitorWellSortedness>false</MonitorWellSortedness>
  <DebugMode>RealTimeAndMemory</DebugMode>
  <Tolerance>0.2</Tolerance>
  <UseAcceleration>true</UseAcceleration>
  <UseTurnDelay>true</UseTurnDelay>
  <RotatePods>false</RotatePods>
  <QueueHandlingEnabled>true</QueueHandlingEnabled>
  <EnergyRobotMassKg>115</EnergyRobotMassKg>
  <EnergySupportPowerEmptyW>0</EnergySupportPowerEmptyW>
  <EnergySupportPowerLoadedW>0</EnergySupportPowerLoadedW>
  <SlowStartEnabled>false</SlowStartEnabled>
  <SlowStartInputEnabled>false</SlowStartInputEnabled>
  <SlowStartUseReservationEta>false</SlowStartUseReservationEta>
  <StarveAwareCostEnabled>false</StarveAwareCostEnabled>
  <StarveAwareFixedParam>30</StarveAwareFixedParam>
  <StarveAwareNominalSpeed>0</StarveAwareNominalSpeed>
  <InputBacklogAwareHold>false</InputBacklogAwareHold>
  <InputSequentialRelease>true</InputSequentialRelease>
  <BackfillProbeEnabled>false</BackfillProbeEnabled>
  <SlowStartReleasePolicy>StationSlack</SlowStartReleasePolicy>
  <SlowStartEtaSafetyBuffer>0</SlowStartEtaSafetyBuffer>
  <SlowStartEtaImprovementLookaheadSec>5</SlowStartEtaImprovementLookaheadSec>
  <SlowStartEtaImprovementReleaseMargin>1</SlowStartEtaImprovementReleaseMargin>
  <SlowStartQueueBudgetMaxSec>0</SlowStartQueueBudgetMaxSec>
  <SlowStartQueueBudgetWorkMultiplier>1</SlowStartQueueBudgetWorkMultiplier>
  <SlowStartQueueBudgetMinOtherExtractTasks>1</SlowStartQueueBudgetMinOtherExtractTasks>
  <StationShutdownThresholdTime>600</StationShutdownThresholdTime>
  <CorrelativeFrequencyTracking>false</CorrelativeFrequencyTracking>
  <IntenseLocationPolling>false</IntenseLocationPolling>
  <DisableHeavyLogging>true</DisableHeavyLogging>
  <OrderBatchingTriggerThreshold>1</OrderBatchingTriggerThreshold>
  <InventoryConfiguration>
    <ItemType>SimpleItem</ItemType>
    <OrderMode>Fixed</OrderMode>
    <SubmitBatches>false</SubmitBatches>
    <InitialInventory>0.7</InitialInventory>
    <IgnoreCapacityForBundleGeneration>false</IgnoreCapacityForBundleGeneration>
    <BufferBundlesUntilInventoryLoad>1.1</BufferBundlesUntilInventoryLoad>
    <WarmupOrderCount>5000</WarmupOrderCount>
    <ItemWeightMin>5</ItemWeightMin>
    <ItemWeightMax>5</ItemWeightMax>
    <BundleSizeMin>6</BundleSizeMin>
    <BundleSizeMax>6</BundleSizeMax>
    <ReturnOrderProbability>0</ReturnOrderProbability>
    <PositionCountMean>1</PositionCountMean>
    <PositionCountStdDev>1</PositionCountStdDev>
    <PositionCountMin>1</PositionCountMin>
    <PositionCountMax>5</PositionCountMax>
    <OrderPositionCountMean>1</OrderPositionCountMean>
    <OrderPositionCountStdDev>1</OrderPositionCountStdDev>
    <OrderPositionCountMin>1</OrderPositionCountMin>
    <OrderPositionCountMax>5</OrderPositionCountMax>
    <DueTimePriorityMode>true</DueTimePriorityMode>
    <DueTimePriorityOrderProbability>0.2</DueTimePriorityOrderProbability>
    <DueTimePriorityOrder>3600</DueTimePriorityOrder>
    <DueTimeOrdinaryOrder>7200</DueTimeOrdinaryOrder>
    <DueTimeOffsetMean>10800</DueTimeOffsetMean>
    <DueTimeOffsetStdDev>900</DueTimeOffsetStdDev>
    <DueTimeOffsetMin>7200</DueTimeOffsetMin>
    <DueTimeOffsetMax>14400</DueTimeOffsetMax>
    <FixedInventoryConfiguration>
      <OrderFile>orders_fill1350.xorders</OrderFile>
    </FixedInventoryConfiguration>
    <DemandInventoryConfiguration>
      <OrderCount>100</OrderCount>
      <BundleCount>200</BundleCount>
      <InventoryLevelDrivenBundleGeneration>true</InventoryLevelDrivenBundleGeneration>
      <InventoryLevelBundleStopThreshold>0.85</InventoryLevelBundleStopThreshold>
      <InventoryLevelBundleRestartThreshold>0.65</InventoryLevelBundleRestartThreshold>
      <InventoryLevelDrivenOrderGeneration>true</InventoryLevelDrivenOrderGeneration>
      <InventoryLevelOrderStopThreshold>0.1</InventoryLevelOrderStopThreshold>
      <InventoryLevelOrderRestartThreshold>0.6</InventoryLevelOrderRestartThreshold>
    </DemandInventoryConfiguration>
    <SimpleItemConfiguration>
      <GeneratorConfigFile>Mu-100.xgenc</GeneratorConfigFile>
    </SimpleItemConfiguration>
  </InventoryConfiguration>
  <CommentTag1 />
  <CommentTag2 />
  <CommentTag3 />
</SettingConfiguration>